# Copy to .env for local runs:  copy .env.example .env   (Windows)
# On Streamlit Community Cloud, put these in the app's Secrets instead.
# NEVER commit a real key.

# ---- Groq (free key: https://console.groq.com/keys) ----------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Faster/lighter alternative on the same free limits: openai/gpt-oss-20b

# ---- Agent ---------------------------------------------------------------
# agent = ReAct with tools (most accurate) | quick = one call (fewest tokens)
AGENT_MODE=agent
AGENT_MAX_STEPS=3
LLM_TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=1500
OBSERVATION_CHARS=1800

# ---- Retrieval & chunking ------------------------------------------------
TOP_K=3
CHUNK_SIZE=400
CHUNK_OVERLAP=60
MAX_CONTEXT_CHUNKS=6
MAX_CONTEXT_CHARS=5000

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PAGES=300
MIN_FIGURE_PX=48

# ---- Misc --------------------------------------------------------------------
# Lets users save answers that override the AI. Keep false on public apps.
ENABLE_FEEDBACK=false
LOG_LEVEL=INFO
